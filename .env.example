# 默认保持 demo；真实验证使用独立启动脚本及已授权、显式初始化的费用台账。
MODEL_MODE=demo
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT=8
MODEL_ATTEMPTS=2
MODEL_BUDGET_PATH=data/model-budget.sqlite3

# 产品默认优先本地公开知识；旧演示/真实路由验证需显式设为 0。
PUBLIC_KNOWLEDGE_ENABLED=1
# PUBLIC_KNOWLEDGE_PATH=/absolute/path/to/knowledge-base.json
# PUBLIC_ACTIVATION_PATH=/absolute/path/to/public_activation.json

# Optional local validation copies; leave unset to use the bundled demo configuration.
# DEMO_CATALOG_PATH=/absolute/path/to/service_catalog.json
# DEMO_KNOWLEDGE_PATH=/absolute/path/to/knowledge.json

# Optional offline Mandarin ASR; demo launcher enables it on this Mac.
LOCAL_ASR_ENABLED=0
# LOCAL_ASR_MODEL=/absolute/path/to/ggml-small.bin
# LOCAL_ASR_CLI=/opt/homebrew/bin/whisper-cli
# LOCAL_ASR_FFMPEG=/opt/homebrew/bin/ffmpeg
