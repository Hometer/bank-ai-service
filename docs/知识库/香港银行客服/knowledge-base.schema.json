{
  "$defs": {
    "FaqArticle": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^HKFAQ-[A-Z]+-[0-9]{2}$",
          "title": "Id",
          "type": "string"
        },
        "bank_id": {
          "enum": [
            "bocom",
            "hsbc",
            "hase",
            "bochk",
            "sc",
            "bea",
            "hkma"
          ],
          "title": "Bank Id",
          "type": "string"
        },
        "evidence_role": {
          "default": "bank_rule",
          "enum": [
            "bank_rule",
            "peer_guidance",
            "regional_guidance"
          ],
          "title": "Evidence Role",
          "type": "string"
        },
        "jurisdiction": {
          "const": "HK",
          "title": "Jurisdiction",
          "type": "string"
        },
        "customer_type": {
          "enum": [
            "personal",
            "enterprise",
            "both"
          ],
          "title": "Customer Type",
          "type": "string"
        },
        "topic": {
          "enum": [
            "payments",
            "digital",
            "statements",
            "cards",
            "accounts",
            "security",
            "consent"
          ],
          "title": "Topic",
          "type": "string"
        },
        "question": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "variants": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Variants",
          "type": "array"
        },
        "patterns": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Patterns",
          "type": "array"
        },
        "exclude_patterns": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Exclude Patterns",
          "type": "array"
        },
        "answer": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "limits": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Limits",
          "type": "string"
        },
        "focus": {
          "enum": [
            "general",
            "materials",
            "channel",
            "fees",
            "qualification",
            "timing",
            "download",
            "guarantee"
          ],
          "title": "Focus",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "claim_locator": {
          "minLength": 1,
          "title": "Claim Locator",
          "type": "string"
        },
        "retrieved_on": {
          "title": "Retrieved On",
          "type": "string"
        },
        "review_due_on": {
          "title": "Review Due On",
          "type": "string"
        },
        "bank_reviewed": {
          "const": false,
          "title": "Bank Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "bank_id",
        "jurisdiction",
        "customer_type",
        "topic",
        "question",
        "variants",
        "patterns",
        "answer",
        "limits",
        "focus",
        "source_ids",
        "claim_locator",
        "retrieved_on",
        "review_due_on",
        "bank_reviewed"
      ],
      "title": "FaqArticle",
      "type": "object"
    },
    "FaqSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "bank_id": {
          "enum": [
            "bocom",
            "hsbc",
            "hase",
            "bochk",
            "sc",
            "bea",
            "hkma"
          ],
          "title": "Bank Id",
          "type": "string"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "jurisdiction": {
          "const": "HK",
          "title": "Jurisdiction",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "verification": {
          "enum": [
            "read_page",
            "read_browser"
          ],
          "title": "Verification",
          "type": "string"
        },
        "retrieved_on": {
          "title": "Retrieved On",
          "type": "string"
        },
        "published_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published On"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "bank_id",
        "entity",
        "title",
        "url",
        "jurisdiction",
        "publisher",
        "verification",
        "retrieved_on",
        "note"
      ],
      "title": "FaqSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "bundle_version": {
      "maxLength": 40,
      "title": "Bundle Version",
      "type": "string"
    },
    "jurisdiction": {
      "const": "HK",
      "title": "Jurisdiction",
      "type": "string"
    },
    "retrieved_on": {
      "title": "Retrieved On",
      "type": "string"
    },
    "review_policy": {
      "title": "Review Policy",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/FaqSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "articles": {
      "items": {
        "$ref": "#/$defs/FaqArticle"
      },
      "title": "Articles",
      "type": "array"
    },
    "exclusions": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Exclusions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "bundle_version",
    "jurisdiction",
    "retrieved_on",
    "review_policy",
    "sources",
    "articles",
    "exclusions"
  ],
  "title": "FaqBundle",
  "type": "object"
}
